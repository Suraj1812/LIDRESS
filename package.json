{
  "name": "lidress",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently --names web,api --prefix-colors green,blue \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "dev:web": "npm run dev --workspace frontend",
    "dev:api": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace backend",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.7.0",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
