{
  "name": "@lidress/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --var ALLOWED_ORIGINS:http://localhost:3000 --var ENVIRONMENT:development",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@decartai/sdk": "0.2.14"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.7.0",
    "vitest": "^5.1.1"
  }
}
