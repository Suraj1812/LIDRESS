{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lidress-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "https://lidress.vercel.app",
    "ENVIRONMENT": "production",
  },
  "ratelimits": [
    {
      "name": "TOKEN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60,
      },
    },
  ],
  "workers_dev": true,
  "preview_urls": false,
}
