{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lidress-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "https://lidress.vercel.app",
    "ENVIRONMENT": "production",
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lidress-commerce",
      "database_id": "a325deaa-8657-4683-b952-a055844b630a",
      "migrations_dir": "migrations",
    },
  ],
}
